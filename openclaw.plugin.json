{
  "id": "cc-bridge-plugin",
  "name": "CC Bridge",
  "description": "Manage Claude Code sessions on worker nodes via tmux + Ray",
  "contracts": {
    "tools": ["cc_start", "cc_send", "cc_read", "cc_keys", "cc_list", "cc_stop"]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "pythonPath": {
        "type": "string",
        "description": "Path to Python interpreter with ray installed"
      },
      "bridgePath": {
        "type": "string",
        "description": "Path to cc_bridge.py (default: ./bridge/cc_bridge.py)"
      },
      "bridgeCwd": {
        "type": "string",
        "description": "Working directory for bridge execution"
      },
      "rayAddress": {
        "type": "string",
        "description": "Ray cluster address (default: auto)"
      },
      "sessionPrefix": {
        "type": "string",
        "description": "Prefix for tmux session names (default: cc-)"
      },
      "defaultCwd": {
        "type": "string",
        "description": "Default working directory for new CC sessions"
      }
    },
    "additionalProperties": false
  }
}
